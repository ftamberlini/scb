# Data locations
ANCINE_DATA_DIR=./data/ancine
DATA_DIR=./data/imdb

# Runtime limits and cache
MAX_CONCURRENT_REQUESTS=8
QUERY_TIMEOUT_SECONDS=60
ANALYTICS_CACHE_MAX_ENTRIES=128
ANALYTICS_CACHE_TTL_SECONDS=300
CORS_ORIGINS=

# Chat controls
CHAT_LLM_MODEL=claude-haiku-4-5-20251001
CHAT_MAX_CONCURRENT_REQUESTS=4
CHAT_TIMEOUT_SECONDS=90
CHAT_SQL_TIMEOUT_SECONDS=30
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=60
# CHAT_ACCESS_KEY=optional-shared-key
# CHAT_SHOW_UNAVAILABLE_MODELS=false

# Configure only the providers that should appear in the model selector.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
